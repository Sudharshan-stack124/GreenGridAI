# ==============================================================================
# GreenGrid User Dashboard — Environment Configuration Template
# IBM Z Datathon 2026
# ==============================================================================

# Data Service API Base URL (FastAPI / Kruthin's service)
# Defaults to local dev port 8001; on LinuxONE point to http://<linuxone-ip>:8001
VITE_DATA_SERVICE_URL=http://localhost:8001

# Decision Engine Service API Base URL (Revanth's service)
# Defaults to local dev port 8002; on LinuxONE point to http://<linuxone-ip>:8002
VITE_DECISION_ENGINE_URL=http://localhost:8002

# AI Explanation Service Base URL (Punith's service / watsonx / Granite)
# Defaults to local dev port 8003; on LinuxONE point to http://<linuxone-ip>:8003
VITE_AI_SERVICE_URL=http://localhost:8003

# Toggle Mock Mode:
# 'true'  = Use internal verified benchmark dataset (v2.1.1 frozen ground truth)
# 'false' = Connect directly to live backend microservices
VITE_USE_MOCKS=true
